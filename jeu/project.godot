; Engine configuration file.
config_version=5

[application]

config/name="Pokémon Kanto"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Data="*res://scripts/autoload/data.gd"
Sprites="*res://scripts/autoload/sprites.gd"
Game="*res://scripts/autoload/game.gd"
Audio="*res://scripts/autoload/audio.gd"
Net="*res://scripts/autoload/net.gd"
Social="*res://scripts/autoload/social.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=320
window/size/window_width_override=1440
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/Jersey10Jeu.ttf"
theme/default_font_antialiasing=0
theme/default_font_size=22

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
